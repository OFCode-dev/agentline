#!/bin/bash
# agentline-run — show a long-running command on agentline's 🤖 segment for
# as long as it runs.
#
#   agentline-run [--label TEXT] [--heartbeat SECONDS|0] -- CMD [ARGS...]
#
#   agentline-run -- codex exec -m gpt-6-astra "review the diff"
#                                   🤖 codex/gpt-6-astra
#   agentline-run --label "nightly eval" -- python3 run_jev.py
#
# Claude Code's subagent panel lists its own subagents only. Work started
# from a shell — codex, agy, a `claude -p` over ssh, a curl to a model
# server, a background job — is invisible there, and this is how it shows up:
# the command registers a row in agentline's agent registry (the file the 🤖
# segment on line 3 reads), refreshes it while it runs, and removes it when
# it ends, whatever way it ends.
#
#   --label TEXT       the row's text. Default: the worker the command runs,
#                      named by the same classifier as the subagent rows
#                      (codex/gpt-6-astra, bayrak/opus, arb/qwen3.6, ...),
#                      else the program's name.
#   --heartbeat SECS   re-register every SECS seconds (default 60; 0: never).
#                      The registry forgets a row after 300 s, so a heartbeat
#                      is what keeps a long job listed — and what brings its
#                      row back should anything have dropped it.
#
# CMD runs with this script's stdin (/dev/null if that is closed), stdout
# and stderr, and its exit status is this script's; a CMD killed by a
# terminating signal gets this script killed by the same signal. It prints
# nothing of its own except errors, on stderr. When the registry helper is
# missing or python3 is not there, CMD simply runs.
#
# Signals: TERM and HUP are passed on to CMD, then the row is removed. INT
# and QUIT are not passed on: Ctrl-C already reaches CMD from the terminal,
# which signals the whole foreground process group, and a second INT would
# cut short a CMD's own clean-up (codex, a python script). A `kill -INT` of
# this process alone therefore stops nothing until CMD ends.
#
# Environment:
#   AGENTLINE_AGENT_HELPER  the registry helper (default: agentline-agent.sh
#                           next to this script, or in hooks/ of a checkout)
#   plus the helper's own: AGENTLINE_TMP, CLAUDE_AGENTS_FILE, ...

usage() {
  echo "usage: ${0##*/} [--label TEXT] [--heartbeat SECONDS|0] -- CMD [ARGS...]" >&2
  exit 2
}

label=""
beat=60
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --label) [ $# -ge 2 ] || usage; label="$2"; shift 2 ;;
    --label=*) label="${1#--label=}"; shift ;;
    --heartbeat) [ $# -ge 2 ] || usage; beat="$2"; shift 2 ;;
    --heartbeat=*) beat="${1#--heartbeat=}"; shift ;;
    -h|--help) sed -n '2,42p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "${0##*/}: unknown option: $1" >&2; usage ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || usage
case "$beat" in ''|*[!0-9]*) echo "${0##*/}: --heartbeat needs a number of seconds" >&2; usage ;; esac

# A closed stdin (`agentline-run … <&-`) is /dev/null for CMD, as for any
# program whose caller gave it none; before, the fd juggling failed on it
# and CMD never ran.
{ : <&0; } 2>/dev/null || exec </dev/null

# The directory this script really lives in: ~/.local/bin/agentline-run is a
# symlink (install.sh --link-bin), and the helpers sit beside the target.
# readlink one level at a time: BSD readlink has no -f.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link=$(readlink "$self") || break
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
here=$(cd "$(dirname "$self")" 2>/dev/null && pwd)

helper="${AGENTLINE_AGENT_HELPER-}"
if [ -z "$helper" ]; then
  for helper in "$here/agentline-agent.sh" "$here/hooks/agentline-agent.sh" ""; do
    [ -f "$helper" ] && break
  done
fi
# Nothing to register with: be the command, and nothing else.
if [ -z "$helper" ] || [ ! -f "$helper" ] || ! command -v python3 >/dev/null 2>&1; then
  exec "$@"
fi

if [ -z "$label" ]; then
  for cls in "$here/agentline-subagents.sh" ""; do
    [ -f "$cls" ] && break
  done
  [ -n "$cls" ] && label=$(bash "$cls" --classify -- "$@" 2>/dev/null)
  # Nothing the classifier would show (its rules refuse a program name that
  # looks like a key or a path): a fixed word, never the raw argv[0].
  [ -n "$label" ] || label=run
fi
# One registry line per row, so no newline or control character may reach
# it; agentline.sh cleans what it prints, this keeps the file well-formed.
# A --label is the caller's own words and is kept, but no longer than a row
# has room for.
label="${label//[[:cntrl:]]/ }"
label="${label:0:40}"

# Nested under an agentline-run that already shows this very label (a
# wrapper script that wraps again): the outer row is this work, and a second
# row with the same label would be taken away by whichever ends first.
_rs=$(printf '\036')
case "${_AGENTLINE_RUN_LABELS-}" in
  *"$_rs$label$_rs"*) exec "$@" ;;
esac
_AGENTLINE_RUN_LABELS="${_AGENTLINE_RUN_LABELS:-$_rs}$label$_rs"
export _AGENTLINE_RUN_LABELS

# The registry key: the label, a unit separator and this run's pid (the
# supervisor's too: it is exec'd). The registry keeps one row per key, so
# two runs with one label used to share a row, and the first to finish took
# it away from the second for up to a heartbeat. agentline.sh shows the part
# before the separator only, and identical labels once, as "label ×2".
key="$label"$'\037'"$$"

# The supervisor: one python3 that becomes this process (exec, so a signal
# sent to agentline-run reaches it) and does all of the child management.
# The shell version it replaced — CMD as a background job, `wait` in a loop,
# traps, a heartbeat subshell — could not be made reliable: on bash 3.2
# (macOS /bin/bash) a signal landing between `kill -0` and `wait` was lost
# and `wait` blocked for good (Ctrl-C hung 7 runs of 12, the heartbeat
# re-adding the row all along); on bash 5 a TERM to the group sometimes made
# `wait` return -1, so the wrapper exited 255 instead of dying of TERM; a
# heartbeat `add` still in flight could land after the final `remove`, a
# ghost row for 300 s; and a CMD exiting 147-150 made it stop itself.
#
# Here every signal it handles is blocked and taken with sigwait(): a signal
# is pending until it is taken, so none can slip between a check and a
# wait. SIGCHLD says CMD may be done, SIGALRM (an interval timer) is the
# heartbeat, TERM and HUP are forwarded, INT and QUIT only noted (the
# terminal gave them to CMD too). Heartbeat and removal run one after the
# other in this one process, so the last word on the row is always the
# remove, in `finally`. A signal the caller had ignored (a background job's
# INT) stays ignored, for CMD as well. The program sits at the top level,
# not inside $(...), where bash 3.2 would parse its lines as shell.
IFS= read -r -d '' _AL_RUN_PY <<'PYEOF'
import os, signal, sys

helper, key, beat = sys.argv[1], sys.argv[2], int(sys.argv[3])
argv = sys.argv[4:]
S = signal
# Signals that end a process: CMD dying of one of these gets this process
# killed by the same one. Any other (a SEGV, a stop signal) is only reported
# as its exit status, 128 + n, the way a shell reports it.
TERMINATING = {S.SIGHUP, S.SIGINT, S.SIGQUIT, S.SIGABRT, S.SIGKILL, S.SIGPIPE,
               S.SIGTERM, S.SIGALRM, S.SIGUSR1, S.SIGUSR2}
waited = {S.SIGCHLD, S.SIGALRM}
for s in (S.SIGTERM, S.SIGHUP, S.SIGINT, S.SIGQUIT):
    if S.getsignal(s) != S.SIG_IGN:
        waited.add(s)
for s in waited:
    # A handler, never run (the signal is blocked and taken by sigwait), so
    # that no signal here has an "ignore" action a blocked signal could be
    # discarded under.
    S.signal(s, lambda *a: None)
S.pthread_sigmask(S.SIG_BLOCK, waited)

def spawn(args, null_fds):
    """fork + exec args with the caller's signal state: nothing blocked,
    SIGPIPE and SIGXFSZ back to default (python ignores them), null_fds on
    /dev/null. Returns the pid, or None when the fork failed."""
    try:
        pid = os.fork()
    except OSError:
        return None
    if pid:
        return pid
    try:
        # Default actions before the unblock: a TERM forwarded between the
        # fork and the exec is pending here, and must kill, not land in the
        # no-op handler (a CMD that then ran on regardless).
        for s in waited | {S.SIGPIPE, S.SIGXFSZ}:
            S.signal(s, S.SIG_DFL)
        S.pthread_sigmask(S.SIG_SETMASK, ())
        if null_fds:
            null = os.open(os.devnull, os.O_RDWR)
            for fd in null_fds:
                os.dup2(null, fd)
        os.execvp(args[0], args)
    except OSError as e:
        try:
            os.write(2, ('agentline-run: %s: %s\n' % (args[0], e.strerror)).encode('utf-8', 'replace'))
        except OSError:
            pass
        os._exit(127 if e.errno == 2 else 126)
    os._exit(126)

def registry(op, quiet=False):
    # The helper never gets the caller's stdin or stdout (a pipe read from
    # this command must close when CMD is done); its stderr, a note that a
    # write was skipped, is kept except for the heartbeat's.
    pid = spawn(['bash', helper, op, key], (0, 1, 2) if quiet else (0, 1))
    if pid:
        try:
            os.waitpid(pid, 0)
        except OSError:
            pass

status = None
registry('add')
try:
    child = spawn(argv, ())
    if child is None:
        sys.stderr.write('agentline-run: cannot start %s\n' % argv[0])
        status = 126 << 8
    else:
        # A Ctrl-C (INT or QUIT to the group) that came while the row was
        # being added reached this process only: CMD did not exist yet. It
        # is still pending here, so it is passed on now. One that came in
        # the microseconds after the fork reached CMD as well and is passed
        # twice, which beats a CMD that never heard it.
        for s in (S.SIGINT, S.SIGQUIT):
            if s in waited and s in S.sigpending():
                try:
                    os.kill(child, s)
                except OSError:
                    pass
        if beat > 0:
            S.setitimer(S.ITIMER_REAL, beat, beat)
        while status is None:
            sig = S.sigwait(waited)
            if sig == S.SIGALRM:
                registry('add', quiet=True)
            elif sig in (S.SIGTERM, S.SIGHUP):
                try:
                    os.kill(child, sig)
                except OSError:
                    pass
            # Any wake-up may follow CMD's end (a heartbeat can consume the
            # moment), so every one checks; SIGCHLD just comes first.
            pid, st = os.waitpid(child, os.WNOHANG)
            if pid:
                status = st
finally:
    S.setitimer(S.ITIMER_REAL, 0)
    registry('remove')

if os.WIFSIGNALED(status):
    n = os.WTERMSIG(status)
    if n in TERMINATING:
        if n != S.SIGKILL:
            S.signal(n, S.SIG_DFL)
        os.kill(os.getpid(), n)
        S.pthread_sigmask(S.SIG_UNBLOCK, {n})
    sys.exit(128 + n)
sys.exit(os.WEXITSTATUS(status) if os.WIFEXITED(status) else 1)
PYEOF

exec python3 -I -c "$_AL_RUN_PY" "$helper" "$key" "$beat" "$@"
